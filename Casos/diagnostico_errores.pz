@modelo "claude-sonnet-4-6"
@formato "texto"

AGENTE diagnosticoMotor {
    // Error de cadena sin cerrar (falta la comilla al final)
    contexto = "Experto en diagnostico de sensores en motores 2.0L
    
    // Error de decimal mal formado (termina en punto)
    variable voltajeSensor = 12.
    
    // Error de carácter no reconocido (el símbolo de dólar)
    $ ANALIZAR voltajeSensor SOBRE "falla de cilindro" 
    
    // Error en el conector (espacio entre el guion y mayor que)
    - > resultado
    
    // Error de comentario de bloque sin cerrar
    /* Seccion de resumen de fallas mecanicas
    
    variable voltajeSensor = 12.5
    RESUMIR resultado EN 50 palabras -> reporteFinal
}