@modelo "claude-sonnet-4-6"
@rol "analista encubierto"
@formato "lista"

// Agente que utiliza identificadores con guion bajo inicial
AGENTE _analista_datos {
    contexto = "Eres un agente extrayendo informacion confidencial"
    variable _archivo_secreto = CARGAR("top_secret.csv")
    
    /* Extraemos los nombres clave
       de la base de datos */
    EXTRAER "nombres en clave" SOBRE _archivo_secreto -> _lista_nombres
    
    RESUMIR _lista_nombres EN 50 palabras -> _resumen_final
}

EJECUTAR _analista_datos
EXPORTAR _resumen_final