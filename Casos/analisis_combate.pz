@modelo "claude-sonnet-4-6"
@rol "estratega de videojuegos"
@formato "texto"

// Agente dedicado a analizar estadisticas de combate
AGENTE estrategaCombate {
    contexto = "Experto en analisis de combates de dificultad maxima"
    variable estadisticas = CARGAR("datos_valquiria_reina.csv")
    variable horasJugadas = 51.5
    
    /* Generamos un desglose de los patrones de ataque
       para optimizar la estrategia de esquive y bloqueo */
    ANALIZAR estadisticas SOBRE "frecuencia de ataques imbloqueables" -> patrones
    
    RESUMIR patrones EN 200 palabras -> estrategiaFinal
}

EJECUTAR estrategaCombate
EXPORTAR estrategiaFinal