@modelo "claude-sonnet-4-6"
@formato "markdown"

AGENTE cuidadorCanino {
    // Error: Cadena sin cerrar en el contexto
    contexto = "Experto en comportamiento de razas grandes
    
    // Error: Caracteres no reconocidos (el hashtag y la exclamacion)
    # CARGAR manual de adiestramiento!
    variable raza1 = "Labrador Retriever"
    variable raza2 = "Old English Sheepdog"
    
    // Error: Decimal mal formado (le falta el numero despues del punto)
    variable racionDiaria = 2.
    
    // Error: Conector roto por espacios
    ANALIZAR raza1 - > temperamento
    
    /* Error: Comentario de bloque que nunca se cierra
    GENERAR tabla DESDE temperamento -> comparativa
}