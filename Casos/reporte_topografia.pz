@modelo "claude-sonnet-4-6"
@rol "ingeniero topografico"
@formato "markdown"

AGENTE reporteLab {
    contexto = "Eres un asistente de ingenieria"
    variable lecturas = CARGAR("cotas_terreno.csv")
    
    /* Calculamos las variaciones de elevacion
       para trazar el perfil longitudinal */
    EXTRAER "puntos criticos" SOBRE lecturas -> puntos
    
    GENERAR codigo DESDE "tabla con " + puntos -> tablaFinal
    RESUMIR tablaFinal EN 150 palabras -> conclusion
}

EJECUTAR reporteLab
EXPORTAR tablaFinal, conclusion